# Copy to .env.local and fill in. Without the Supabase values the site runs in
# demo mode: engine and content hub work, accounts are disabled.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Only used by `npm run db:seed`. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin, used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: an MP4 played for lessons that have no recording uploaded yet.
NEXT_PUBLIC_DEMO_VIDEO_URL=
