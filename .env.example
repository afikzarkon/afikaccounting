# Copy to .env.local and fill in. Without the Supabase values the site runs in
# demo mode: engine and content hub work, accounts are disabled.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only — never expose it to the browser. Used by `npm run db:seed`, and by
# the payments webhook to apply the provider's events (it bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=

# "1" shows "Continue with Google" on sign-in and sign-up. Turn it on after
# enabling Google in Supabase → Authentication → Providers (with the client id
# and secret from Google Cloud), and adding <NEXT_PUBLIC_SITE_URL>/auth/callback
# to Supabase → Authentication → URL Configuration → Redirect URLs.
NEXT_PUBLIC_GOOGLE_AUTH=

# Public origin, used in auth email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: an MP4 played for lessons that have no recording uploaded yet.
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Demo mode only (no Supabase): act as a reader on this plan — free, courses or
# exams — to see the locks and paywalls. Unset, demo mode opens everything.
ACCESS_PREVIEW_TIER=

# ---------------------------------------------------------------------------
# Payments. Unset BILLING_PROVIDER = payments off: "choose a plan" signs the
# reader up with the plan noted, as before, and the webhook answers 404.
# Payments also need Supabase and SUPABASE_SERVICE_ROLE_KEY above.
# ---------------------------------------------------------------------------
# Which provider adapter runs (src/lib/billing/providers/<name>.ts).
#   sandbox — a built-in stand-in for development: a fake payment page on this
#             site, signed webhooks, test invoices. No real money. It runs only
#             when NEXT_PUBLIC_SITE_URL is localhost, unless the flag below is set.
BILLING_PROVIDER=
# The secret the provider signs its webhooks with (from the provider's
# dashboard; for the sandbox, any long random string). The webhook address to
# give the provider: <NEXT_PUBLIC_SITE_URL>/api/billing/webhook
BILLING_WEBHOOK_SECRET=
# Let the sandbox run on a non-local site (a staging deployment). Never in production.
BILLING_SANDBOX_ALLOW_REMOTE=
# A real provider's own keys (terminal number, API key…) are added here with
# its adapter, under BILLING_<PROVIDER>_* names.

# Search engines. Unset = robots.txt closes the whole site (right for previews and
# for the time before launch). Set to 1 on the production site when it goes public.
SITE_INDEXING=

# Study reminders by email (opt-in in /profile). The scheduler (vercel.json) calls
# /api/reminders daily with "Authorization: Bearer <CRON_SECRET>"; unset, the route
# does not exist. Unset EMAIL_PROVIDER = dry run (nothing is sent; the route reports
# what it would send). REMINDERS_SECRET signs the one-click unsubscribe links
# (falls back to CRON_SECRET). Needs SUPABASE_SERVICE_ROLE_KEY.
CRON_SECRET=
REMINDERS_SECRET=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
